# Copy to .env and fill in:  cp .env.example .env
#
# No TUNNEL_TOKEN needed here: the client reuses the existing cloudflared
# container (~/projects/cloudflare) via the shared external "tunnel_net" network.

# Public URL of your REST API. Must be HTTPS, because the client is served over HTTPS
# (browsers block http:// requests from https:// pages).
API_BASE_URL=https://brian.aselaboratory.com/api/items
